{
  "manifest_version": 3,
  "name": "transcribe-thing",
  "description": "Tells the transcribe-thing app which tab holds a call and whether your mic is muted. Nothing leaves your Mac.",
  "version": "1.0.0",
  "minimum_chrome_version": "111",
  "key": "",
  "permissions": ["nativeMessaging", "tabs", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["page.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["relay.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ]
}
